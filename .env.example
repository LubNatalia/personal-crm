# Copy to .env and fill in the values. Never commit .env.

# PostgreSQL in Docker (used by docker-compose.yml)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=5432

# Connection string for the app: postgresql://USER:PASSWORD@localhost:PORT/DB
DATABASE_URL=

BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
SMTP_URL=
OWNER_EMAIL=